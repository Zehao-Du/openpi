#!/bin/bash

/bin/bash -lc '
set -eo pipefail
cd /inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/openpi \
&& source /inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/miniconda3/etc/profile.d/conda.sh \
&& conda activate zehao_openpi \
&& export OPENPI_ROOT=/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/openpi \
&& export PATH="/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/uv-bin:$PATH" \
&& export HF_LEROBOT_HOME=/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/dataset/lerobot \
&& export WANDB_MODE=offline \
&& ConfigName=pi05_recolor_pika_pull_stick_200_0831_v21 \
&& LogName=pi05_recolor_pika_pull_stick_200_0831_v21

NUM_SHARDS=8
ShardPrefix=${LogName}_shard
mkdir -p Logs/data
worker_pids=()
cleanup_workers() {
    for pid in "${worker_pids[@]}"; do
        kill "${pid}" 2>/dev/null || true
    done
}

KEEPALIVE_PGID=
cleanup_keepalive() {
    if [[ -z "${KEEPALIVE_PGID}" ]]; then
        return
    fi
    if kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null; then
        kill -TERM -- "-${KEEPALIVE_PGID}" 2>/dev/null || true
        for _ in {1..20}; do
            kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null || break
            sleep 1
        done
        if kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null; then
            kill -KILL -- "-${KEEPALIVE_PGID}" 2>/dev/null || true
        fi
    fi
    wait "${KEEPALIVE_PGID}" 2>/dev/null || true
    KEEPALIVE_PGID=
}

cleanup() {
    cleanup_workers
    cleanup_keepalive
}
trap cleanup EXIT

setsid uv run --project . python scripts/job_on_qz/gpu_keepalive.py &
KEEPALIVE_PGID=$!
sleep 5
kill -0 -- "-${KEEPALIVE_PGID}"

for gpu in $(seq 0 $((NUM_SHARDS - 1))); do
    CUDA_VISIBLE_DEVICES=${gpu} uv run --project examples/realman_pika --no-sync python \
        examples/realman_pika/pull_stick/recolor_convert_all_pika_data_to_lerobot.py \
        --repo-id Zehao123/${ShardPrefix}_${gpu} \
        --task-prompt "pull the {color} stick and place it on the desk" \
        --num-shards=${NUM_SHARDS} \
        --shard-index=${gpu} \
        --overwrite \
        >Logs/data/${ShardPrefix}_${gpu}.log 2>&1 &
    worker_pids+=("$!")
done

worker_failed=0
for pid in "${worker_pids[@]}"; do
    wait "${pid}" || worker_failed=1
done
worker_pids=()
if [[ "${worker_failed}" -ne 0 ]]; then
    echo "At least one recolor shard failed; inspect Logs/data/${ShardPrefix}_*.log" >&2
    exit 1
fi

ShardInputs=()
for shard in $(seq 0 $((NUM_SHARDS - 1))); do
    ShardInputs+=("Zehao123/${ShardPrefix}_${shard}")
done
uv run --project examples/realman_pika --no-sync python \
    examples/realman_pika/merge_lerobot_v21_shards.py \
    --inputs "${ShardInputs[@]}" \
    --repo-id Zehao123/pi05_recolor_pika_pull_stick_200_0831_v21 \
    --overwrite

uv run --project . scripts/compute_norm_stats.py --config-name=${ConfigName}
kill -0 -- "-${KEEPALIVE_PGID}"
cleanup_keepalive
trap - EXIT

mkdir -p Logs/train
XLA_PYTHON_CLIENT_MEM_FRACTION=0.9 uv run --project . scripts/train.py ${ConfigName} \
--exp-name=${LogName} \
--fsdp-devices=8 \
--num-workers=8 \
--overwrite \
2>&1 | tee Logs/train/${LogName}.log
'
