#!/bin/bash

/bin/bash -lc '
set -eo pipefail
cd /inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/openpi \
&& source /inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/miniconda3/etc/profile.d/conda.sh \
&& conda activate zehao_openpi \
&& export OPENPI_ROOT=/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/openpi \
&& export PATH="/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/uv-bin:$PATH" \
&& export HF_LEROBOT_HOME=/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/dataset/lerobot \
&& export WANDB_MODE=offline \
&& ConfigName=pi05_keypoint_pika_pull_stick_351_0902_v21 \
&& LogName=pi05_keypoint_pika_pull_stick_351_0902_v21 \
&& OldRepoId=Zehao123/pi05_keypoint_pika_pull_stick_1437_v21 \
&& NewDataDir=/inspire/hdd/project/robot-dna/baojiachun-CZXS25130063/zehao/dataset/pika/pull_stick/pullstick_0901_gripper \
&& SourceRunDir=checkpoints/pi05_keypoint_pika_pull_stick_1437_v21/pi05_keypoint_pika_pull_stick_1437_v21 \
&& SourceCheckpointDir=${SourceRunDir}/35000 \
&& TargetRunDir=checkpoints/${ConfigName}/${LogName}

if [[ ! -d "${SourceCheckpointDir}" ]]; then
    echo "Missing source checkpoint: ${SourceCheckpointDir}" >&2
    exit 1
fi
if [[ ! -f "${SourceCheckpointDir}/_CHECKPOINT_METADATA" ]]; then
    echo "Incomplete source checkpoint: ${SourceCheckpointDir}/_CHECKPOINT_METADATA is missing" >&2
    exit 1
fi
if [[ ! -f "${SourceRunDir}/wandb_id.txt" ]]; then
    echo "Missing source W&B run ID: ${SourceRunDir}/wandb_id.txt" >&2
    exit 1
fi
if [[ -e "${TargetRunDir}" ]]; then
    echo "Refusing to overwrite target checkpoint directory: ${TargetRunDir}" >&2
    exit 1
fi

KEEPALIVE_PGID=
cleanup_keepalive() {
    if [[ -z "${KEEPALIVE_PGID}" ]]; then
        return
    fi
    if kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null; then
        kill -TERM -- "-${KEEPALIVE_PGID}" 2>/dev/null || true
        for _ in {1..20}; do
            kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null || break
            sleep 1
        done
        if kill -0 -- "-${KEEPALIVE_PGID}" 2>/dev/null; then
            kill -KILL -- "-${KEEPALIVE_PGID}" 2>/dev/null || true
        fi
    fi
    wait "${KEEPALIVE_PGID}" 2>/dev/null || true
    KEEPALIVE_PGID=
}
trap cleanup_keepalive EXIT

setsid uv run --project . python scripts/job_on_qz/gpu_keepalive.py &
KEEPALIVE_PGID=$!
sleep 5
kill -0 -- "-${KEEPALIVE_PGID}"

uv run --project examples/realman_pika --no-sync python \
examples/realman_pika/pull_stick/visualprompt_convert_all_pika_data_to_lerobot.py \
--data-dir "${NewDataDir}" \
--append-from-repo-id "${OldRepoId}" \
--repo-id "Zehao123/${ConfigName}" \
--overwrite
uv run --project . scripts/compute_norm_stats.py --config-name="${ConfigName}"

kill -0 -- "-${KEEPALIVE_PGID}"
cleanup_keepalive

mkdir -p "${TargetRunDir}"
cp -a "${SourceCheckpointDir}" "${TargetRunDir}/35000"
cp -a "${SourceRunDir}/wandb_id.txt" "${TargetRunDir}/wandb_id.txt"

mkdir -p Logs/train
XLA_PYTHON_CLIENT_MEM_FRACTION=0.9 uv run --project . scripts/train.py "${ConfigName}" \
--exp-name="${LogName}" \
--fsdp-devices=8 \
--num-workers=8 \
--resume \
2>&1 | tee "Logs/train/${LogName}.log"
'
